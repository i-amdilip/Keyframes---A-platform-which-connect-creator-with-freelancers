{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account record storing role and account status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["creator", "freelancer"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 1000 },
        "channelName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "accountStatus", "createdAt", "updatedAt"]
    },
    "FreelancerProfile": {
      "title": "FreelancerProfile",
      "description": "Public freelancer profile, services, packages, and portfolio showcase.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "headline": { "type": "string", "minLength": 4, "maxLength": 160 },
        "bio": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "skills": { "type": "array" },
        "startingPrice": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "completedOrders": { "type": "number" },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "coverUrl": { "type": "string", "maxLength": 500 },
        "portfolioItems": { "type": "array" },
        "packages": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "headline", "bio", "category", "skills", "startingPrice", "status", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Creator-published project brief open for freelancer proposals.",
      "type": "object",
      "properties": {
        "creatorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "title": { "type": "string", "minLength": 5, "maxLength": 160 },
        "description": { "type": "string", "minLength": 15, "maxLength": 3000 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "requiredSkills": { "type": "array" },
        "budget": { "type": "number" },
        "deadline": { "type": "string", "minLength": 4, "maxLength": 40 },
        "referenceUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["open", "in_progress", "completed", "cancelled"] },
        "proposalCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["creatorUid", "creatorName", "title", "description", "category", "requiredSkills", "budget", "deadline", "status", "proposalCount", "createdAt", "updatedAt"]
    },
    "Proposal": {
      "title": "Proposal",
      "description": "Freelancer bid submitted for a creator project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "projectTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "creatorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "freelancerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "freelancerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "freelancerHeadline": { "type": "string", "maxLength": 160 },
        "proposedPrice": { "type": "number" },
        "deliveryDays": { "type": "number" },
        "coverMessage": { "type": "string", "minLength": 10, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "projectTitle", "creatorUid", "freelancerUid", "freelancerName", "proposedPrice", "deliveryDays", "coverMessage", "status", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Active collaboration order tracking delivery, revisions, and completion.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "proposalId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "creatorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "freelancerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "freelancerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "price": { "type": "number" },
        "platformFee": { "type": "number" },
        "netPayout": { "type": "number" },
        "deadline": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["ordered", "in_progress", "delivered", "revision_requested", "completed", "cancelled"] },
        "deliveryUrl": { "type": "string", "maxLength": 500 },
        "deliveryNotes": { "type": "string", "maxLength": 2000 },
        "revisionNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "creatorUid", "creatorName", "freelancerUid", "freelancerName", "price", "platformFee", "netPayout", "status", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct messaging thread between a creator and a freelancer.",
      "type": "object",
      "properties": {
        "participantUids": { "type": "array" },
        "creatorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "freelancerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "freelancerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "projectId": { "type": "string", "maxLength": 128 },
        "projectTitle": { "type": "string", "maxLength": 160 },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastSenderUid": { "type": "string", "maxLength": 128 },
        "unreadByCreator": { "type": "boolean" },
        "unreadByFreelancer": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantUids", "creatorUid", "creatorName", "freelancerUid", "freelancerName", "unreadByCreator", "unreadByFreelancer", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual chat message inside a conversation subcollection.",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "participantUids": { "type": "array" },
        "senderUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "body": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "attachmentUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "participantUids", "senderUid", "senderName", "body", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified creator review for a completed order.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "freelancerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "freelancerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "creatorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "creatorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "freelancerId", "freelancerUid", "creatorUid", "creatorName", "rating", "comment", "createdAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Order payment escrow and freelancer withdrawal ledger entry.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "orderTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "creatorUid": { "type": "string", "maxLength": 128 },
        "freelancerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "grossAmount": { "type": "number" },
        "platformCommission": { "type": "number" },
        "netAmount": { "type": "number" },
        "type": { "type": "string", "enum": ["order_record", "withdrawal"] },
        "status": { "type": "string", "enum": ["pending", "held", "released", "requested", "paid"] },
        "payoutMethod": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderTitle", "freelancerUid", "grossAmount", "platformCommission", "netAmount", "type", "status", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User-scoped notification item.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "body": { "type": "string", "minLength": 1, "maxLength": 400 },
        "linkTab": { "type": "string", "maxLength": 60 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "title", "body", "read", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Moderation report submitted for admin review.",
      "type": "object",
      "properties": {
        "reporterUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["freelancer", "project"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "reason": { "type": "string", "minLength": 5, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["open", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterUid", "targetType", "targetId", "targetName", "reason", "status", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Marketplace creative service category.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "active", "createdAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Admin role grant document keyed by UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user account profiles keyed by Auth UID."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Admin access registry."
    },
    "/freelancers/{freelancerId}": {
      "schema": { "$ref": "#/entities/FreelancerProfile" },
      "description": "Publicly discoverable freelancer profiles."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Publicly browsable creator projects."
    },
    "/proposals/{proposalId}": {
      "schema": { "$ref": "#/entities/Proposal" },
      "description": "Proposals submitted by freelancers to creators."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Active and completed collaboration orders."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Creator-freelancer conversation metadata."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside a conversation."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Verified reviews on completed orders."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Payment records, commissions, and withdrawal requests."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time notifications per user."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Reported profiles and projects for admin moderation."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Admin-managed marketplace categories."
    }
  }
}
